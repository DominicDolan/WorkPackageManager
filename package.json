{
  "name": "work-task-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Repo-local development task tracker with visual before/after evidence, driven by aio-visual-regression.",
  "bin": {
    "tasks": "./bin/tasks"
  },
  "files": [
    "bin/**/*",
    "src/**/*",
    "dist/**/*",
    "prompts/**/*",
    "docs/solid-2.0/**/*",
    "vite.config.ts",
    "tsconfig.json",
    "README.md"
  ],
  "keywords": [
    "tasks",
    "cli",
    "visual-regression",
    "developer-tools"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "cli": "bun run src/cli/index.ts",
    "serve": "bun run src/server/index.ts",
    "dev:api": "bun --watch run src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,js,json,jsx,md,ts,tsx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.6",
    "solid-js": "2.0.0-rc.6"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "^1.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  }
}
