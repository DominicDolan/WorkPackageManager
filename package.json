{
    "name": "work-task-manager-monorepo",
    "private": true,
    "type": "module",
    "description": "Monorepo for work-task-manager: the domain core, the HTTP API, a typed client, the default web UI and the `tasks` CLI.",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "bin": {
        "tasks": "./bin/tasks"
    },
    "engines": {
        "bun": ">=1.2.0"
    },
    "scripts": {
        "cli": "bun run packages/cli/src/index.ts",
        "serve": "bun run packages/server/src/main.ts",
        "dev:api": "bun --watch run packages/server/src/main.ts",
        "dev:web": "bun run --cwd packages/web dev",
        "build": "bun run --cwd packages/web build",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{css,html,js,json,jsx,md,ts,tsx,yaml,yml}": "prettier --write"
    },
    "devDependencies": {
        "@types/bun": "^1.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.2"
    }
}
