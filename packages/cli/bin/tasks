#!/usr/bin/env bash
# Thin shim so `tasks` works from anywhere — whether npm linked it into a global
# bin or it is symlinked by hand. The CLI walks up from $PWD to find the repo's
# .tasks/ workspace, so it does not care where it is invoked from; what it does
# need is a real bun, and the package directory this script lives in.
#
# The symlink chase below is what makes both true: npm's global bin entry is a
# symlink, and resolving it is the only way to find the CLI package's own src/.
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *)  script_path="$(dirname "$script_path")/$link_target" ;;
  esac
done

package_root="$(cd "$(dirname "$script_path")/.." && pwd)"

# Find bun without depending on the calling shell's PATH. Nushell is the login
# shell here and adds ~/.bun/bin itself, but a plain bash login shell does not,
# so resolving it here keeps `tasks` working from either.
bun_bin="${BUN_BIN:-}"
if [ -z "$bun_bin" ]; then
  if command -v bun >/dev/null 2>&1; then
    bun_bin="$(command -v bun)"
  else
    for candidate in "$HOME/.bun/bin/bun" /usr/local/bin/bun /opt/homebrew/bin/bun \
                     /home/linuxbrew/.linuxbrew/bin/bun; do
      if [ -x "$candidate" ]; then
        bun_bin="$candidate"
        break
      fi
    done
  fi
fi

if [ -z "$bun_bin" ]; then
  echo "tasks: could not find 'bun'. Install it, put it on PATH, or set BUN_BIN." >&2
  exit 1
fi

exec "$bun_bin" run "$package_root/src/index.ts" "$@"
